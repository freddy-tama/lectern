{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/draft-deck.ts": { "maxDuration": 300 },
    "api/deck-questions.ts": { "maxDuration": 120 },
    "api/lecture-notes.ts": { "maxDuration": 300 },
    "api/revise-slide.ts": { "maxDuration": 300 },
    "api/deck-assistant.ts": { "maxDuration": 300 },
    "api/make-code.ts": { "maxDuration": 300 },
    "api/picture-search.ts": { "maxDuration": 30 },
    "api/picture-fetch.ts": { "maxDuration": 60 },
    "api/picture-generate.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/((?!api/|assets/|samples/|icons/|media/|sw\\.js|manifest\\.webmanifest).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
